{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Generated by .github/workflows/build.yml for PR preview versions.
  //
  // The Worker name deliberately matches the existing dev DB Worker so its
  // ADMIN_KEY and JWT_SECRET bindings are inherited. The workflow supplies
  // Cloudflare's preview-only Turnstile test secret with `--secrets-file`.
  // PR_PREVIEW makes auth email delivery fail closed even if Wrangler also
  // inherits the dev Worker's RESEND_API_KEY. `versions upload` only creates
  // an immutable preview version; it does not replace the active
  // api-dev.mercurypitch.com deployment.
  "name": "mercury-pitch-db-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "secrets": {
    "required": ["ADMIN_KEY", "JWT_SECRET", "TURNSTILE_SECRET"],
  },
  "vars": {
    "PR_PREVIEW": "true",
    "GOOGLE_CLIENT_ID": "940402390643-sb89ek7ocuoikqpd5llc6ike4fasccdl.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "*.workers.dev",
    "APP_FALLBACK_ORIGIN": "https://dev.mercurypitch.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mercurypitch-db-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      // The preview DB follows the same tracked chain as dev/prod; the
      // workflow runs `d1 migrations apply` against this config, and
      // wrangler resolves the directory relative to the config file.
      "migrations_dir": "migrations",
    },
  ],
  // Preview audio is intentionally durable across PR updates in the shared
  // preview catalogue. It remains separate from production media.
  "r2_buckets": [
    {
      "binding": "GUIDED_MEDIA_BUCKET",
      "bucket_name": "mercurypitch-guided-media-dev",
    },
  ],
}
