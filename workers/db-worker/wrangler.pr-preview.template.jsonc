{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Generated by .github/workflows/build.yml for one PR at a time.
  //
  // The Worker name deliberately matches the existing dev DB Worker so its
  // ADMIN_KEY and JWT_SECRET bindings are inherited. `versions upload` only
  // creates an immutable preview version; it does not replace the active
  // api-dev.mercurypitch.com deployment.
  "name": "mercury-pitch-db-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "secrets": {
    "required": ["ADMIN_KEY", "JWT_SECRET"],
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "144271507987-du7ue2880rjbn83felsak0j3fefukkuq.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "*.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__PR_DATABASE_NAME__",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  // Object keys are UUID-based. The PR-close cleanup reads its isolated D1
  // rows and removes only the media objects created by that preview.
  "r2_buckets": [
    {
      "binding": "GUIDED_MEDIA_BUCKET",
      "bucket_name": "mercurypitch-guided-media-dev",
    },
  ],
}
