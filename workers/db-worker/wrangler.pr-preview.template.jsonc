{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Generated by .github/workflows/build.yml for PR preview versions.
  //
  // This is a dedicated Worker identity. It must never match the development
  // or production DB Worker: Wrangler preserves omitted secrets from the
  // newest version of one Worker, even when that version is not deployed.
  // Sharing an identity therefore lets preview credentials contaminate a
  // later environment deploy. The workflow generates this Worker's only
  // private binding (JWT_SECRET) for every immutable preview version.
  "name": "mercury-pitch-db-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "secrets": {
    "required": ["JWT_SECRET"],
  },
  "vars": {
    "PR_PREVIEW": "true",
    // Cloudflare publishes this always-pass test secret for automated test
    // environments. Keeping it on the dedicated preview Worker as a plain
    // version binding makes the pairing auditable and cannot affect dev.
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "GOOGLE_CLIENT_ID": "940402390643-sb89ek7ocuoikqpd5llc6ike4fasccdl.apps.googleusercontent.com",
    // No PASSKEY_RP_ID on purpose, so the passkey routes answer 503 here.
    // workers.dev is on the Public Suffix List: no relying-party id can be
    // minted for it, by anyone. 2FA and email-code sign-in work as normal.
    "ALLOWED_ORIGINS": "*.workers.dev",
    "APP_FALLBACK_ORIGIN": "https://dev.mercurypitch.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mercurypitch-db-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      // The preview DB follows the same tracked chain as dev/prod; the
      // workflow runs `d1 migrations apply` against this config, and
      // wrangler resolves the directory relative to the config file.
      "migrations_dir": "migrations",
    },
  ],
  // Preview audio is intentionally durable across PR updates in the shared
  // preview catalogue. It remains separate from production media.
  "r2_buckets": [
    {
      "binding": "GUIDED_MEDIA_BUCKET",
      "bucket_name": "mercurypitch-guided-media-dev",
    },
  ],
}
