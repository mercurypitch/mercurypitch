{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mercury-pitch-db",
  // Worker implementation lands in src/index.ts (Hono CRUD API).
  // Until then this config exists so `wrangler d1 execute` / migrations work.
  "main": "src/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Public OAuth client id (Web application) — not a secret.
    // JWT_SECRET, ADMIN_KEY and GOOGLE_CLIENT_SECRET are real secrets:
    // `wrangler secret put <NAME>` (per env). GOOGLE_CLIENT_SECRET powers
    // the redirect sign-in flow; this worker's /api/auth/google/callback
    // URL must be an Authorized redirect URI on the Google OAuth client.
    "GOOGLE_CLIENT_ID": "144271507987-du7ue2880rjbn83felsak0j3fefukkuq.apps.googleusercontent.com",
    // Browser-origin allowlist (see Env.ALLOWED_ORIGINS). Local `wrangler
    // dev` (pnpm dev:db, no --env) accepts only localhost origins.
    "ALLOWED_ORIGINS": "localhost",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mercurypitch-db",
      // Filled in by scripts/init-cloudflare-db.sh after `wrangler d1 create`
      "database_id": "35d9bae5-4818-4acf-8bd1-4644b6b24949",
      // Tracked schema history. `wrangler d1 migrations apply` records applied
      // files in d1_migrations, so each runs exactly once per database.
      "migrations_dir": "migrations",
    },
    {
      // Supporter-perk grants. ONE database shared by dev AND prod on
      // purpose (grants are email-keyed and published once per person) —
      // every env block references this same database_id.
      "binding": "PERKS_DB",
      "database_name": "mercurypitch-perks",
      "database_id": "09a3f6ce-b16f-47e8-b232-78420bc823cd",
      "migrations_dir": "migrations-perks",
    },
  ],
  // Create this permanent bucket before deployment. Do not attach the UVR
  // input/output lifecycle rules: published exercise playback is immutable.
  "r2_buckets": [
    {
      "binding": "GUIDED_MEDIA_BUCKET",
      "bucket_name": "mercurypitch-guided-media",
    },
    {
      // Private premium originals and variants. No public domain and no UVR
      // expiry rules: published revision keys are immutable. The top-level
      // config mirrors prod for local/default config resolution; supported
      // deployments still use the explicit `--env dev|prod` scripts below.
      "binding": "PREMIUM_BACKGROUNDS_BUCKET",
      "bucket_name": "mercurypitch-premium-backgrounds-prod",
    },
  ],
  "services": [
    {
      "binding": "JAM_WORKER",
      "service": "mercury-pitch-jam",
      "entrypoint": "JamHostVerifier",
    },
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
  },
  // Custom subdomain per env (api.mercurypitch.com / api-dev.mercurypitch.com).
  // NOTE: deploying with custom_domain routes DISABLES the workers.dev URLs —
  // anything registered against them (e.g. Stripe webhook endpoints) breaks
  // silently. External callbacks must always point at the custom domains
  // (this bit us 2026-07-08→18: credit grants died on both Stripe modes).
  // A dedicated
  // host — not a /api/* route on the shared mercurypitch.com domain — avoids
  // shadowing the main worker's /api/uvr/* and /api/share/* routes. wrangler
  // auto-creates the custom domain + DNS record on deploy (the zone is on
  // Cloudflare). The frontend points at the right worker via VITE_API_BASE_URL
  // per build; the OAuth /api/auth/google/callback is derived from the
  // request origin, so it follows whichever host the frontend uses.
  // Billing reconciliation sweep (src/billing.ts reconcileBilling): grants
  // any paid checkout whose webhook delivery was lost. Keep in every env.
  "triggers": { "crons": ["17 */6 * * *"] },
  // workers.dev stays OFF everywhere (custom_domain routes disable it
  // implicitly; a top-level deploy has no routes, so pin it here too —
  // NOTHING may point at workers.dev hosts, see the routes note above).
  "workers_dev": false,
  "env": {
    "dev": {
      "name": "mercury-pitch-db-dev",
      "workers_dev": false,
      "triggers": { "crons": ["17 */6 * * *"] },
      "routes": [
        { "pattern": "api-dev.mercurypitch.com", "custom_domain": true },
        // Second door to the SAME worker, for the Cloudflare Access
        // application to sit in front of. It exists because Access matches
        // on hostname + path and admin-ness here is decided by METHOD:
        // `GET /api/weekly/active` is public and `POST /api/weekly` is
        // admin, on one path. No pattern on api-dev can separate them, so
        // gating that host would bounce every anonymous visitor to a
        // Cloudflare login. Requests arriving here carry
        // `Cf-Access-Jwt-Assertion`, which `resolveAdmin` already accepts —
        // no code branches on the hostname.
        { "pattern": "studio-dev.mercurypitch.com", "custom_domain": true },
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "144271507987-du7ue2880rjbn83felsak0j3fefukkuq.apps.googleusercontent.com",
        // Managed campaign identities exist only in the development database.
        // Set the dedicated TESTING_PROVISION_KEY with:
        // `wrangler secret put TESTING_PROVISION_KEY --env dev`.
        // Production intentionally omits this switch, so the route is a 404.
        "ALLOW_TEST_ACCOUNT_PROVISIONING": "1",
        // Emailed links (reset/verify) from non-first-party origins (PR
        // previews) land on the dev app, never production.
        "APP_FALLBACK_ORIGIN": "https://dev.mercurypitch.com",
        // Dev is the testing environment: the dev frontend, any localhost port
        // (local vite, tour walks), and per-PR preview Workers may call it.
        // `*.workers.dev` allows the versioned preview frontends
        // (<version>-mercurypitch-preview.<subdomain>.workers.dev), whose
        // hostnames aren't known ahead of time — broad, but scoped to dev
        // (test data, rate-limited). Prod (below) never lists it.
        "ALLOWED_ORIGINS": "https://dev.mercurypitch.com,localhost,*.workers.dev",
        // ACCESS_TEAM_DOMAIN / ACCESS_AUD / ACCESS_ALLOWED_EMAILS /
        // ACCESS_STRICT are NOT here: this repo is public and the first two
        // identify the account. Set them per environment with
        // `wrangler secret put`.
        //
        // `resolveAdmin` is STAGED, and the stages are easy to misread:
        //   - team domain + aud set, ACCESS_STRICT unset — a verified
        //     Access token grants admin, and X-Admin-Key STILL WORKS. This
        //     is the safe default and the only one usable today.
        //   - ACCESS_STRICT=1 — the key stops working and a token is
        //     required. Do not set this yet: the browser studio is served
        //     from dev.mercurypitch.com and calls this worker
        //     cross-origin, so it cannot carry the Access cookie
        //     (third-party) and would 403 on every write.
        //   - neither set — the key is the only gate (local, previews).
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mercurypitch-db-dev",
          // Filled in by scripts/init-cloudflare-db.sh (run: pnpm db:init:dev)
          "database_id": "e00340be-93fd-44ee-b22e-cb1124a1aadc",
          "migrations_dir": "migrations",
        },
        {
          // Shared with prod — see the top-level PERKS_DB note.
          "binding": "PERKS_DB",
          "database_name": "mercurypitch-perks",
          "database_id": "09a3f6ce-b16f-47e8-b232-78420bc823cd",
          "migrations_dir": "migrations-perks",
        },
      ],
      "r2_buckets": [
        {
          "binding": "GUIDED_MEDIA_BUCKET",
          "bucket_name": "mercurypitch-guided-media-dev",
        },
        {
          "binding": "PREMIUM_BACKGROUNDS_BUCKET",
          "bucket_name": "mercurypitch-premium-backgrounds-dev",
        },
      ],
      "services": [
        {
          "binding": "JAM_WORKER",
          "service": "mercury-pitch-jam-dev",
          "entrypoint": "JamHostVerifier",
        },
      ],
    },
    "prod": {
      "name": "mercury-pitch-db",
      "workers_dev": false,
      "triggers": { "crons": ["17 */6 * * *"] },
      "routes": [
        { "pattern": "api.mercurypitch.com", "custom_domain": true },
        // The Access-gated door — see the dev block for why a second
        // hostname rather than a path on the API host. Its Access
        // application is SEPARATE from dev's and has its own audience tag,
        // so `ACCESS_AUD` differs per env and a dev token cannot be
        // replayed here. `ACCESS_TEAM_DOMAIN` is shared (one Zero Trust
        // org).
        { "pattern": "studio.mercurypitch.com", "custom_domain": true },
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "144271507987-du7ue2880rjbn83felsak0j3fefukkuq.apps.googleusercontent.com",
        "APP_FALLBACK_ORIGIN": "https://mercurypitch.com",
        // PROD IS STRICT: only the real app domains. No localhost — a
        // locally served build must never reach the prod DB (this is what
        // let tour walks/previews create thousands of junk anonymous
        // users). Requests without an Origin header still pass (Stripe
        // webhooks, OAuth callback navigation, admin curl/seed scripts).
        "ALLOWED_ORIGINS": "https://mercurypitch.com,https://www.mercurypitch.com,https://about.mercurypitch.com",
        // ACCESS_* are secrets, not vars — see the dev block above, which
        // also documents the staging. `workers_dev: false` means there is
        // no *.workers.dev hostname for this Worker, so the route list
        // below is the complete set of ways in.
        //
        // Which is the point worth being blunt about: api.mercurypitch.com
        // is NOT behind Access and must not be — the public app calls it.
        // So while ACCESS_STRICT is unset, the admin key remains a way in
        // that bypasses the Access gate entirely. Access is defence in
        // depth here, not yet the gate. ACCESS_STRICT=1 is what closes it,
        // and that needs the studio talking to studio.mercurypitch.com
        // first.
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mercurypitch-db",
          "database_id": "35d9bae5-4818-4acf-8bd1-4644b6b24949",
          "migrations_dir": "migrations",
        },
        {
          // Shared with dev — see the top-level PERKS_DB note.
          "binding": "PERKS_DB",
          "database_name": "mercurypitch-perks",
          "database_id": "09a3f6ce-b16f-47e8-b232-78420bc823cd",
          "migrations_dir": "migrations-perks",
        },
      ],
      "r2_buckets": [
        {
          "binding": "GUIDED_MEDIA_BUCKET",
          "bucket_name": "mercurypitch-guided-media-prod",
        },
        {
          "binding": "PREMIUM_BACKGROUNDS_BUCKET",
          "bucket_name": "mercurypitch-premium-backgrounds-prod",
        },
      ],
      "services": [
        {
          "binding": "JAM_WORKER",
          "service": "mercury-pitch-jam",
          "entrypoint": "JamHostVerifier",
        },
      ],
    },
  },
}
