{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-with-cloud-db",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "cross-env",
        "VITE_API_BASE_URL=http://localhost:8788",
        "VITE_OVERRIDE_ONNX_MODEL=",
        "vite"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "app-http",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "cross-env",
        "MP_DEV_HTTP=1",
        "VITE_OVERRIDE_ONNX_MODEL=",
        "vite"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "app-host",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "cross-env",
        "VITE_OVERRIDE_ONNX_MODEL=",
        "vite",
        "--host"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "jam-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "run-p", "dev:jam", "dev:host"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "drum-night",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "cross-env", "VITE_OVERRIDE_ONNX_MODEL=", "vite"],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
