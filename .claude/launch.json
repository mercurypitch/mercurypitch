{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-with-cloud-db",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "cross-env",
        "VITE_API_BASE_URL=http://localhost:8788",
        "VITE_OVERRIDE_ONNX_MODEL=",
        "vite"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "app-http",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "cross-env",
        "MP_DEV_HTTP=1",
        "VITE_OVERRIDE_ONNX_MODEL=",
        "vite"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "app-host",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "cross-env",
        "VITE_OVERRIDE_ONNX_MODEL=",
        "vite",
        "--host"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "beside-cue",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@irchiinnuss/beside-cue-app",
        "dev",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "beside-cue-host",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@irchiinnuss/beside-cue-app",
        "dev",
        "--port",
        "5199",
        "--strictPort",
        "--host"
      ],
      "port": 5199
    },
    {
      "name": "beside-cue-https",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@irchiinnuss/beside-cue-app",
        "dev",
        "--port",
        "5199",
        "--strictPort",
        "--host",
        "--mode",
        "https"
      ],
      "port": 5199,
      "url": "https://localhost:5199"
    },
    {
      "name": "jam-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "run-p", "dev:jam", "dev:host"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "drum-night",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "cross-env", "VITE_OVERRIDE_ONNX_MODEL=", "vite"],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
