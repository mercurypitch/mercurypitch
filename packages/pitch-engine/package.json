{
  "name": "@irchiinnuss/pitch-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Microphone lifecycle and SwiftF0 pitch detection stream shared by MercuryPitch products. Source of truth for game/runtime pitch input; the root app migrates onto it incrementally.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "import": "./src/assets.ts",
      "default": "./src/assets.ts"
    },
    "./pitch-detector": {
      "types": "./src/pitch-detector.ts",
      "import": "./src/pitch-detector.ts",
      "default": "./src/pitch-detector.ts"
    },
    "./pitch-detector-internals": {
      "types": "./src/pitch-detector-internals.ts",
      "import": "./src/pitch-detector-internals.ts",
      "default": "./src/pitch-detector-internals.ts"
    },
    "./signal-quality": {
      "types": "./src/signal-quality.ts",
      "import": "./src/signal-quality.ts",
      "default": "./src/signal-quality.ts"
    },
    "./swift-f0-detector": {
      "types": "./src/swift-f0-detector.ts",
      "import": "./src/swift-f0-detector.ts",
      "default": "./src/swift-f0-detector.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "onnxruntime-web": "^1.25.1"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
