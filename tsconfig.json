{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // ES2024 for the type checker only; "target" stays ES2023, so nothing
    // about the emitted code changes. The repo already uses an ES2024 API —
    // Promise.withResolvers, six times in
    // useGuitarNightReferenceController.test.tsx — and tsc rejected it. The
    // usage is test-only, so no shipped code depends on an ES2024 runtime.
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vitest/globals", "node", "@webgpu/types"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": "./",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.devices.config.ts",
    "playwright.cloud.config.ts"
  ],
  "plugins": [
    {
      "name": "typescript-plugin-css-modules",
      "options": {
        "classnameTransform": "camelCaseOnly",
        "goToDefinition": true
      }
    }
  ],
  "exclude": ["node_modules", "dist"]
}
