# Production build env (loaded by `vite build` / `pnpm run build`).
# Mirrors .env.development. Without VITE_API_BASE_URL the prod build ships with
# cloud accounts disabled ("no API configured"), so point it at the prod
# db-worker on its dedicated custom subdomain — a branded host for the Google
# OAuth consent screen; the frontend talks to it directly.
VITE_API_BASE_URL=https://api.mercurypitch.com

# Google Ads tag — PROD ONLY (this file loads only for `vite build` / prod
# deploys; dev + PR-preview use `build:dev` → .env.development, which omits it,
# so they stay inert). Setting it activates the EEA/UK/CH consent banner and
# Consent Mode conversion tracking on the next prod deploy. No ad spend follows
# — the campaign is enabled separately in Google Ads.
VITE_GOOGLE_ADS_TAG_ID=AW-18321142458

# Google Analytics 4 (behaviour analytics — dwell, retention, journeys). Loaded
# through the same gtag + consent banner. Prod-only, same as the ad tag —
# activates on the next prod deploy. Property "MercuryPitchLanding".
VITE_GA4_MEASUREMENT_ID=G-2B9F97KGNW

# Cloudflare Turnstile PUBLIC site key — see the note in .env.development.
# Its private half is the db-worker's TURNSTILE_SECRET wrangler secret. Both
# must be set together: the worker gate fails closed, so a secret without this
# key breaks every register / login / forgot-password.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADwxFpbIS2KUOInz

# Glassworks belongs to Beside Cue for now, so mercurypitch.com serves
# /glass-game (page, assets, service-worker rule) without pointing at it: no
# Home card or tour step, no sitemap / llms.txt / prelude link, and the page is
# `noindex`. `pnpm run build` asserts exactly that. To list it here as well,
# set 1 and change the `--unlisted` in package.json's `build` script to
# `--listed`. See tools/glassworks-listing.ts.
VITE_GLASSWORKS_LISTED=0

# Find Your Pitch's draft lessons wait on a sign-off before they reach
# mercurypitch.com. Every build carries their pages, and the site worker
# decides at run time: a draft the admin console has not published answers
# the 404 page, and every page lists it as planned, with no link (prod's
# LESSON_DRAFTS is 0 in wrangler.jsonc; src/lesson-gate.ts). This is the
# same default for a page no worker served, so a production bundle on its
# own links no draft, and `pnpm run build` asserts that. A lesson is
# released when its line leaves src/features/lessons/kit/drafts.ts; this
# stays 0. See tools/draft-lessons.ts.
VITE_DRAFT_LESSONS=0

# Retention periods for the ids this browser holds (src/lib/funnel.ts,
# src/lib/acquisition.ts): the Google click id is dropped this many days
# after capture, and the funnel id is replaced, with its acquisition record,
# this many months after it was issued. Whole numbers only; anything else
# means the default in src/lib/retention-periods.ts (90 and 13). The worker
# applies the same periods to its rows (RETENTION_* in
# workers/db-worker/wrangler.jsonc), and the privacy notice states them.
VITE_RETENTION_CLICK_ID_DAYS=90
VITE_RETENTION_FUNNEL_ID_MONTHS=13

# Experimental features (Studio first) are off on mercurypitch.com: no nav tab
# or tour, no sitemap / llms.txt / prelude link, and their entry pages say
# `noindex`; `pnpm run build` asserts exactly that. Each page is still served,
# so the owner can switch a feature on for production from his console
# (GET /api/features on the db-worker) without a release. Graduating one is
# deleting it from src/lib/experimental-features.ts, not setting 1 here.
# See tools/experimental-features.ts.
VITE_EXPERIMENTAL_FEATURES=0
