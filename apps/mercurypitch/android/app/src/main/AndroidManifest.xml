<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live pitch detection while the singer is in a room, analysed on the
         device. BOTH permissions are required, not just RECORD_AUDIO:
         Capacitor's BridgeWebChromeClient asks for MODIFY_AUDIO_SETTINGS *and*
         RECORD_AUDIO when the WebView requests audio capture, and it grants
         the WebView request only if every permission in that batch comes
         back granted. An undeclared permission can never be granted, so
         leaving MODIFY_AUDIO_SETTINGS out makes getUserMedia fail on device
         even while Android settings shows Microphone as allowed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- A Karaoke song that keeps playing behind another app. The
         media-session plugin (@capgo/capacitor-media-session) runs a
         foreground service of type mediaPlayback while a song plays or is
         paused, with its notification; without one, Android freezes a
         backgrounded app within seconds and the song stops. The plugin's own
         manifest declares FOREGROUND_SERVICE and the service, but not the
         per-type permission that targetSdk 34+ requires before
         startForeground() with that type is allowed. Play Console asks for a
         foreground service declaration for it (media playback). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
</manifest>
