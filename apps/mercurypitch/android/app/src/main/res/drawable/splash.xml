<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-Android-12 launch frame: the ground with the brand mark centred
     at 96 dp. It replaces the stock Capacitor splash bitmaps (S4 §5). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mp_launch_ground" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/launch_mark"
        android:gravity="center" />
</layer-list>
