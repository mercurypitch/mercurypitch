# Generated, not ours to format.
#
# `ios` and `android` are Capacitor's output. Prettier skips their Swift,
# plist and Gradle files anyway under --ignore-unknown, but after a `cap sync`
# both hold a full copy of the built bundle -- ios/App/App/public and
# android/app/src/main/assets/public -- and those are JS, CSS and HTML that
# prettier very much will try to check.
android
ios
dist

# Staged at build time by scripts/sync-native-assets.mjs. It holds the web
# app's own .svg character art, which prettier formats, so an unformatted
# master in public/ would fail this app's check for a file it never wrote.
.native-public
public

# The example songs' notes. Written compact by
# scripts/generate-karaoke-example-notes.mjs and never edited by hand: the
# three files are 170 KB as one line each, and several times that pretty.
native-only/karaoke/examples/*/notes.json
