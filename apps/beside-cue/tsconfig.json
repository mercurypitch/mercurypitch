{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vitest/globals", "vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // src/purchases/purchase-build-policy.ts imports
    // @irchiinnuss/purchase-kit, whose exports point "types" at src/index.ts:
    // a source package compiles under its consumer's options, and the
    // `./build-policy.ts` it re-exports keeps the extension Node's ESM loader
    // needs when Vite externalises the package while bundling a config file.
    // Legal because `noEmit` is true.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "capacitor.config.ts"
  ],
  "exclude": ["android", "dist", "node_modules"]
}
