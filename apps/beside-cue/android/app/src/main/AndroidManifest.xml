<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
    </application>

    <!-- No microphone: its only user, the B-side games, is out of this build
         (src/games/entry.ts), and a permission nothing asks for is a
         store review question.

         When the games return, restore the RECORD_AUDIO and
         MODIFY_AUDIO_SETTINGS permissions together with an optional
         (required="false") android.hardware.microphone feature. BOTH
         permissions are required, not just RECORD_AUDIO: Capacitor's
         BridgeWebChromeClient asks for MODIFY_AUDIO_SETTINGS *and*
         RECORD_AUDIO when the WebView requests audio capture, and it grants
         the WebView request only if every permission in that batch comes
         back granted. An undeclared permission can never be granted, so
         leaving MODIFY_AUDIO_SETTINGS out makes getUserMedia fail on device
         even while Android settings shows Microphone as allowed. -->
</manifest>
