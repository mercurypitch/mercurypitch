{
  "name": "@irchiinnuss/beside-cue-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint src && prettier --check . --ignore-unknown",
    "test": "vitest",
    "test:run": "vitest run",
    "cap:sync": "pnpm build && cap sync android",
    "cap:open:android": "pnpm cap:sync && cap open android",
    "cap:run:android": "pnpm cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource/coiny": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@irchiinnuss/beside-cue-core": "workspace:*",
    "@irchiinnuss/mobile-runtime": "workspace:*",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@solidjs/testing-library": "^0.8.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@types/node": "^22.0.0",
    "eslint": "9.39.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^4.1.5"
  }
}
