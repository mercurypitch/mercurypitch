# Beside Cue build configuration.
# Copy to .env.local (gitignored) and fill in the values you need.
#
# RevenueCat public SDK keys ship inside the app binary by design, so these
# are not secrets. They are still per-store and per-environment, so keep the
# real ones out of Git and out of anyone else's build.

# Google Play key from RevenueCat -> Project settings -> API keys ("goog_...").
# Leave unset in development and the app falls back to the Test Store key.
# Required for any build you upload to Play.
VITE_REVENUECAT_ANDROID_KEY=

# App Store key ("appl_..."). Required once the iOS project exists.
VITE_REVENUECAT_IOS_KEY=

# Entitlement identifier, exactly as spelled in the RevenueCat dashboard.
# Defaults to "BeSideCue Pro".
VITE_REVENUECAT_ENTITLEMENT_ID=

# Pin a specific offering instead of whichever one the dashboard marks
# current. Leave unset unless you are testing an alternative paywall.
VITE_REVENUECAT_OFFERING_ID=

# Set to 1 to replace the store with a fake one so the Pro loop can be walked
# in a browser. Development builds only; ignored anywhere else. The query
# parameter ?mockPurchases does the same thing without a restart.
VITE_MOCK_PURCHASES=
