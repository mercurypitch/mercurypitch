{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mercurypitch",
  "compatibility_date": "2026-04-30",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "main": "src/worker.ts",
  // Wrangler runs this on every deploy, so THIS is the bundle that ships --
  // CI's earlier "Build app" step is a gate whose output is discarded. Both
  // are deliberate; see docs/agent/MISTAKES.md, "Build-time env vars go on
  // the wrangler step". Any VITE_* that must reach users belongs on the
  // wrangler step, not on the gate.
  "build": {
    "command": "pnpm run build",
  },
  "assets": {
    "directory": "dist",
    // `binding` exposes env.ASSETS to the Worker so its non-/api fallthrough
    // (src/worker.ts) can serve assets. Required: without it env.ASSETS is
    // undefined and any non-asset path (e.g. /exercises/<slug>) 500s.
    "binding": "ASSETS",
    // Real 404s. This was "single-page-application", which handed index.html
    // and a 200 to every unmatched path: /llms.txt, /foo/bar and every probe
    // and dead link answered as if they were the home page. Google reads those
    // as soft 404s, and on a site whose problem is that too few of its pages
    // are indexed at all, spending crawl budget on infinite fake pages is the
    // opposite of what it needs. The only path that genuinely relied on the
    // fallback was /exercises/<slug>, which src/worker.ts now serves on
    // purpose via run_worker_first below.
    "not_found_handling": "404-page",
    // CRITICAL: with static assets + SPA not_found_handling, the asset layer
    // answers every path NOT listed here WITHOUT invoking the Worker — non-GET
    // requests get an empty 405 and unknown GETs get index.html. Every
    // Worker-owned route MUST be listed or it silently dies at the asset
    // layer (2026-07-19 prod incident: /api/uvr/* server separation returned
    // empty 405s and mirror.mercurypitch.com served the SPA shell).
    //   /api/*  — UVR bridge, share API, JSON 404 guard (src/worker.ts)
    //   /       — mirror.mercurypitch.com root serves mirror.html via the
    //             Worker's hostname check; the main site's / falls through
    //             to env.ASSETS inside the Worker.
    //   glass aliases — served as glass.html content with the URL preserved
    //             (no byte-copied HTML files, unlike mirror/karaoke aliases;
    //             /glass itself maps via html_handling).
    //   /exercises/* — served as the studio shell with the URL preserved, so
    //             the client can read the slug.
    //   /admin*  — the friendly admin entries, likewise: no file behind them,
    //             the client rewrites the path to a hash route on boot.
    "run_worker_first": [
      "/api/*",
      "/",
      "/break-glass-with-your-voice",
      "/high-note-test",
      "/shatter",
      // Serves mirror.html at /free-sing with the URL intact. Without this
      // line the asset layer answers first and hands back the SPA shell.
      "/free-sing",
      // Marketing deep links. With not_found_handling now "404-page", these
      // have no file to fall back to — without this line every /exercises/*
      // link on the landing page returns 404.
      "/exercises/*",
      // The friendly admin entries, for the same reason. Two patterns, not
      // three: wrangler rejects `/admin/` as redundant against `/admin/*`,
      // which settles that the wildcard covers the trailing slash. The bare
      // `/admin` it does not cover, and wrangler accepts both.
      "/admin",
      "/admin/*",
    ],
  },
  "compatibility_flags": ["nodejs_compat"],
  // Local dev (plain `wrangler dev`, no --env) needs the R2 staging bucket
  // too: without it every upload over the 7 MB inline cap — and every
  // instrumental split, whose WAV payload is far bigger — 503s before
  // dispatch. `remote: true` binds the REAL dev bucket (a local simulation
  // would be useless: the RunPod handler must fetch the staged key with its
  // own S3 creds). Dev bucket only — never the prod one.
  "r2_buckets": [
    {
      "binding": "UVR_INPUT_BUCKET",
      "bucket_name": "mercurypitch-uvr-output",
      "remote": true,
    },
  ],
  "env": {
    "prod": {
      "name": "mercurypitch",
      "routes": [
        { "pattern": "mercurypitch.com", "custom_domain": true },
        // Voice Mirror standalone entry — the worker serves mirror.html at
        // this hostname's root (src/worker.ts). custom_domain creates the
        // DNS record automatically on deploy.
        { "pattern": "mirror.mercurypitch.com", "custom_domain": true },
      ],
      "kv_namespaces": [
        { "binding": "SHARE_STORE", "id": "d7c42a4fac32488ab199890ac050ebb8" },
      ],
      // Temp holding for server-side separation inputs too big to inline into
      // the RunPod job payload (>7 MB). The worker streams them here under
      // `input/`; the handler downloads them by S3 key. 1-day lifecycle rule
      // on the `input/` prefix expires them.
      "r2_buckets": [
        {
          "binding": "UVR_INPUT_BUCKET",
          "bucket_name": "mercurypitch-uvr-output-prod",
        },
      ],
      // db-worker base URL — lets the worker meter RunPod jobs against the
      // credit ledger (debits no-op until a tier's credit cost is set in
      // pricingPlans, so this is safe to ship ahead of pricing).
      "vars": {
        "DB_API_URL": "https://api.mercurypitch.com",
        // Object-key prefix RunPod's prod endpoint writes stems under in the
        // R2 output bucket (matches the `expire-runpod` 1-day lifecycle rule).
        // Lets the worker serve stems straight from R2 for ~24 h after RunPod
        // forgets the job (~30 min).
        "RUNPOD_STEM_PREFIX": "runpod",
      },
    },
    "dev": {
      "name": "mercurypitch-dev",
      "routes": [{ "pattern": "dev.mercurypitch.com", "custom_domain": true }],
      "kv_namespaces": [
        { "binding": "SHARE_STORE", "id": "6770f5ce13f64e4a9bcefb74039a7d9a" },
      ],
      "r2_buckets": [
        {
          "binding": "UVR_INPUT_BUCKET",
          "bucket_name": "mercurypitch-uvr-output",
        },
      ],
      "vars": {
        "DB_API_URL": "https://api-dev.mercurypitch.com",
        // Dev endpoint writes stems under `runpod-dev/` in the dev output
        // bucket `mercurypitch-uvr-output` (matches its `expire-runpod-dev`
        // 1-day lifecycle rule). Must equal the endpoint's S3_KEY_PREFIX.
        "RUNPOD_STEM_PREFIX": "runpod-dev",
      },
      "build": {
        "command": "pnpm run build:dev",
      },
    },
    "preview": {
      "name": "mercurypitch-preview",
      // A named environment inherits NOTHING from the top level, so a binding
      // the Worker reads has to be repeated here or it is simply absent at
      // runtime. Both entries below REFERENCE dev's existing store — neither
      // creates anything, so a preview deploy provisions no new Cloudflare
      // resource of any kind. Never the prod stores.
      //
      // SHARE_STORE: share-handler.ts reads it unguarded, so /api/share/*
      //   500s without it. The client swallows that (tryShortenUrl returns
      //   null and the caller falls back to the long URL), so the symptom is
      //   a share link that is never shortened rather than a broken share —
      //   which is exactly why it went unnoticed. Wrangler cannot warn here:
      //   there is no top-level kv_namespaces to compare an env against.
      // UVR_INPUT_BUCKET: this is the binding Wrangler DOES warn about, and
      //   the honest reason to declare it is the warning plus the day preview
      //   gets RunPod secrets. Server separation cannot run on a preview
      //   today — the mercurypitch-preview Worker holds only JWT_SECRET, no
      //   RUNPOD_API_KEY or endpoint id — so nothing writes to this bucket.
      //   `"r2_buckets": []` does NOT silence the warning; Wrangler compares
      //   binding names, so it then complains the name is missing instead.
      // RUNPOD_STEM_PREFIX is deliberately absent: it is read only on the
      // RunPod path, which cannot run here.
      "kv_namespaces": [
        { "binding": "SHARE_STORE", "id": "6770f5ce13f64e4a9bcefb74039a7d9a" },
      ],
      "r2_buckets": [
        {
          "binding": "UVR_INPUT_BUCKET",
          "bucket_name": "mercurypitch-uvr-output",
        },
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "DB_API_URL": "https://api-dev.mercurypitch.com",
      },
      "build": {
        "command": "pnpm run build:dev",
      },
    },
  },
}
