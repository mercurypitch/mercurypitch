+// Destroys a file's stream once its response has closed: every response
+// emits 'close', when sent, ended without a body, or left by the client.
+const closeWith = (response, stream) => {
+	if (response.destroyed) {
+		stream.destroy();
+	} else {
+		response.once('close', () => stream.destroy());
+	}
+};
