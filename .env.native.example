# Break Glass — native build environment (loaded by `vite --mode native`).
# Copy to `.env.native.local` (gitignored) with real values for local builds,
# or inject in CI (see codemagic.yaml, which writes this file from a variable
# group before building).
#
# RevenueCat PUBLIC SDK keys — RevenueCat dashboard → Project → API Keys →
# "Public app-specific" keys (appl_… for Apple, goog_… for Google). These are
# safe to ship in the client; they are NOT the secret server-side key.
VITE_RC_IOS_KEY=appl_REPLACE_ME
VITE_RC_ANDROID_KEY=goog_REPLACE_ME
